# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: if set, the /api/generate endpoint requires this value in the
# "X-Access-Key" header. Leave unset for no protection (fine for a private
# internal tool; set it if the URL could be discovered by outsiders).
ACCESS_KEY=
